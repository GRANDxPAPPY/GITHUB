@inject KENTUCKY_WATCHBILL1.Storage.DataService dataService
@using KENTUCKY_WATCHBILL1.Components.Layout
@using System.Linq
@using KENTUCKY_WATCHBILL1.Storage
<PopUp IsVisible="@IsVisible" Title="Add User" OnClose="OnClose">
   <label for="">Username: </label>
   <input @bind="userName"/>
    <label for="">Password: </label>
    <input @bind="userPass"/>
    <label for="">Sailor Name: </label>
    <input @bind="sailorName"/>
    <label for=""> </label>
    <select @bind="userRole">
        <option value="">--Select Role--</option>
        <option value="Section Member">Section Member</option>
        <option value="Section Leader">Section Leader</option>
        <option value="WBC">WBC</option>
        <option value="Admin">Admin</option>
    </select>
    <select @bind="userSection">
        <option value="">--Select Section--</option>
        @foreach(var section in sectionList)
        {
            <option value="@section.sectionId">@section.sectionName</option>
        }

    </select>
    <label>Quals</label>
    <label for="BDW">BDW</label>
    <input type="checkbox" id="BDW" @bind="isQualifiedBDW" />
    <label for="POOD">POOD</label>
    <input type="checkbox" id="POOD" @bind="isQualifiedPOOD" />
    <label for="BDW">TRW</label>
    <input type="checkbox" id="TRW" @bind="isQualifiedTRW" />

    <!--add functionality to add users to database hear-->
    <button @onclick="PopDown">Cancel</button>
    <button @onclick="CreateUser">Submit</button>
</PopUp>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public int UserID { get; set; }


    internal string userName;
    internal string userPass;
    internal string sailorName;

    private List<User> userList;
    private List<Section> sectionList = new();

    internal string userRole;
    internal int userSection;
    bool isQualifiedBDW;
    bool isQualifiedPOOD;
    bool isQualifiedTRW;
    protected override async Task OnParametersSetAsync()
    {
        userList = await dataService.GetUsers();
        sectionList = await dataService.GetSections();
    }
    


    internal async Task CreateUser()
    {
        List<string> checkingString = new List<string> { userRole, sailorName, userName, userPass ,userSection.ToString()};
        bool isNull = false;
        foreach (var s in checkingString)
        {
            if (string.IsNullOrWhiteSpace(s)) isNull = true;

        }
        if (isNull){
            Application.Current.Windows[0].Page.DisplayAlertAsync("Warning", "All blocks must be filled before entering user", "OK"); 
            return;
        }

        var user = new User { role = userRole, sailorName = sailorName, userName = userName, userPassword = userPass , sectionId = userSection};
        
        int userId = await dataService.AddUser(user);
        Quals quals = new Quals { BDW = isQualifiedBDW, POOD = isQualifiedPOOD, TRW = isQualifiedTRW, userId = userId,sectionId = userSection };
        
        await dataService.AddQuals(quals);
        PopDown();
        
    }

    internal async Task PopDown()
    {
        await OnClose.InvokeAsync();
    }

}
