@code {
    //need parameter of passing ID
    [Parameter]
    public int UserId { get; set; }

    List<User> userList = new List<User>();
    protected override async Task OnInitializedAsync()
    {
        await GetUsers();
    }
    //
    internal async Task GetUsers()
    {
        await DataService.GetUsers();
    }

    
}
