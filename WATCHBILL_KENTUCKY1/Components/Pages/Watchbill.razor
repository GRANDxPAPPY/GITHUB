<div class="watchbill-container">
    <header class="watchbill-header">
        <h2>USS KENTUCKY (SSBN 737) IN-PORT WATCHBILL</h2>
        <div class="header-meta">
            <strong>DUTY SECTION:</strong> 1 &nbsp;&nbsp;|&nbsp;&nbsp; <strong>DATE:</strong> 05MAR26
        </div>
    </header>

    <div class="watchbill-grid">
        <div class="left-column">
            <div class="leadership-block">
                <div class="role-box"><strong>SDO</strong><div class="assigned-name">COLLINS</div></div>
                <div class="role-box"><strong>DCPO</strong><div class="assigned-name"> GROSSMAN</div></div>
                <div class="role-box"><strong>EDO</strong><div class="assigned-name"> FLOODS</div></div>
                <div class="role-box"><strong>EDPO</strong><div class="assigned-name"> SMITH</div></div>
                <div class="role-box"><strong>SECTION LEADER</strong><div class="assigned-name"> BAKIRDAN</div></div>
            </div>

            <div class="stations-table">
                <div class="table-header">
                    <div>WATCH STATIONS</div>
                    <div>BDW</div>
                    <div>POOD</div>
                    <div>TRW</div>
                    <!--<div>BARGE</div>-->
                </div>
                <div class="table-row">
                    <div class="station-name">0800 - 1200- <!--the times will go here!--></div>
                    
                    
                </div>
                <div class="table-row">
                    <div class="station-name">1200 - 1600</div>
                    <div class="watchstander">ENGLE</div>
                    <div class="watchstander">HERALD</div>
                    <div class="watchstander">ORDUNA</div>
                </div>
                <div class="table-row">
                    <div class="station-name">1600 - 2000</div>
                    <div class="watchstander">HACKNEY</div>
                    <div class="watchstander">JONES</div>
                    <div class="watchstander">MILLER</div>
                </div>
                <div class="table-row">
                    <div class="station-name">2000 - 0000</div>
                    <div class="watchstander">HACKNEY</div>
                    <div class="watchstander">JONES</div>
                    <div class="watchstander">MILLER</div>
                </div>
                <div class="table-row">
                    <div class="station-name">0000 - 0400</div>
                    <div class="watchstander">HACKNEY</div>
                    <div class="watchstander">JONES</div>
                    <div class="watchstander">MILLER</div>
                </div>
                <div class="table-row">
                    <div class="station-name">0400 - TURN</div>
                    <div class="watchstander">HACKNEY</div>
                    <div class="watchstander">JONES</div>
                    <div class="watchstander">MILLER</div>
                </div>
            </div>
        </div>

        <div class="right-column">
            <div class="personnel-table">
                <div class="table-header">
                    <div>WATCHSTANDER</div>
                    <div class="text-center">B</div>
                    <div class="text-center">P</div>
                    <div class="text-center">T</div>
                    <div class="text-center">ASSIGNED</div>
                </div>
                @foreach(User sectionMember in sectionList)
                {
                    Quals qual = qualificationList.FirstOrDefault(s => s.userId == sectionMember.userId);
                    <div class="table-row">
                        <div>@sectionMember.sailorName.ToUpper()</div>
                        
                        <div class="text-center qualification-check">@(qual?.BDW == true ? "X": "")</div>
                        <div class="text-center qualification-check">@(qual?.POOD == true ? "X" : "")</div>
                        <div class="text-center qualification-check">@(qual?.TRW == true ? "X" : "")</div>
                        <div class="text-center role-tag">WSL</div>
                    </div>
                }
                
                
            </div>
        </div>
    </div>
</div>

@code {
    //need parameter of passing ID
    [Parameter]
    public int UserId { get; set; }
    List<Quals> qualificationList = new List<Quals>();
    List<User> sectionList = new List<User>();
    protected override async Task OnInitializedAsync()
    {
        await GetData();
    }
    //
    internal async Task GetData()
    {
        User activeUser = await DataService.GetUserById(UserId);
        sectionList = await DataService.GetUserBySectionId(activeUser.sectionId);
        qualificationList = await DataService.GetQualsBySectionId(activeUser.sectionId);
    }
    

    
}
