                    <div class="text-center role-tag">W</div>
                </div>
                <div class="table-row">
                    <div>ITR2 ERICKSON</div>
                    <div class="text-center qualification-check">X</div>
                    <div class="text-center qualification-check"></div>
                    <div class="text-center qualification-check">X</div>
                    <div class="text-center role-tag">R</div>
                </div>
                <div class="table-row">
                    <div>ITN2 CAPE</div>
