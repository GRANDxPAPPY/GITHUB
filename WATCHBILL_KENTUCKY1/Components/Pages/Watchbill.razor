                <div class="role-box"><strong>EDPO</strong><div class="assigned-name">EM1 SMITH</div></div>
                <div class="role-box"><strong>SECTION LEADER</strong><div class="assigned-name">STS2 BAKIRDAN</div></div>
            </div>

            <div class="stations-table">
                <div class="table-header">
                    <div>WATCH STATION</div>
                    <div>0800 - 1200</div>
                    <div>1200 - 1600</div>
                    <div>1600 - 2000</div>
                </div>
                <div class="table-row">
