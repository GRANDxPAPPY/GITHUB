@page "/userEdit/{UserId:int}"
@using KENTUCKY_WATCHBILL1.Components.PopUps
<h3>This will be for editing users</h3>
<button @onclick="ShowAddUser">Add User</button>
<button @onclick="ShowEditUser">Edit User</button>
<button @onclick="ShowDeleteUser">Delete User</button>
<button @onclick="ShowSectionEdit">Sections</button>


@if(showAddUserVar ==true)
{
    <Add_User_PopUp IsVisible="@showAddUserVar" OnClose="() => showAddUserVar = false" UserID="@UserId"></Add_User_PopUp>
}

@if(showEditUserVar)
{
    <Edit_User_PopUp IsVisible="@showEditUserVar" OnClose="() => showEditUserVar = false"></Edit_User_PopUp>
}

@if (showDeleteUserVar)
{
    <Delete_User_PopUp IsVisible="@showDeleteUserVar" OnClose="() => showDeleteUserVar = false"></Delete_User_PopUp>
}

@if(showSectionEditVar)
{
    <Edit_Section IsVisible="@showSectionEditVar" OnClose="() => showSectionEditVar = false"></Edit_Section>
}
@code {
    [Parameter]
    public int UserId { get; set; }

    bool showAddUserVar = false;
    bool showEditUserVar = false;
    bool showDeleteUserVar = false;
    bool showSectionEditVar = false;
    private  void ShowAddUser()
    {
        showAddUserVar = true;
    }
    private void ShowEditUser()
    {
        showEditUserVar = true;
    }
    private void ShowDeleteUser()
    {
        showDeleteUserVar = true;
    }
    private void ShowSectionEdit()
    {
        showSectionEditVar = true;
    }
}
