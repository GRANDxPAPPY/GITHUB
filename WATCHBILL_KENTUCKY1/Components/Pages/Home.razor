@page "/"
@using KENTUCKY_WATCHBILL1.Storage
@inject DataService DataService
@inject NavigationManager Nav;

<h1 class="lock_screen_title">@placeHolderSection</h1>
<br />
<h1 class="lock_screen_title">Sign In</h1>

<input @bind="userName" />
<input @bind="userPass"  />
<button @onclick="SubmitUser">Submit</button>

@code
{
    string placeHolderSection;
    string userName;
    string userPass;

    protected override async Task OnInitializedAsync()
    {
        await DataService.Init();
        placeHolderSection = "Hello!";
    }

    private async Task SubmitUser()
    {
        var returnedUser = await DataService.GetUser(userName);
        if (returnedUser.userName != null && returnedUser.userPassword !=null)
        {
            if(returnedUser.userName == userName && returnedUser.userPassword ==userPass){
                if(returnedUser.role == "user")
                {
                    Nav.NavigateTo($"/main/{returnedUser.userId}");
                }
                else if (returnedUser.role =="admin" || returnedUser.role == "WBC")
                {
                    Nav.NavigateTo($"/userEdit/{returnedUser.userId}");
                }
            }
                
            
            // @onclick='() => Nav.NavigateTo($"/CoursePage/{course.courseId}")
        }
        else
        {
            //put message box here
        }

    }
    
}